{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fine-line-projects",
  "compatibility_date": "2026-11-05",
  "pages_build_output_dir": ".",
  "unsafe": {
    "bindings": [
      {
        "name": "ENQUIRY_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
